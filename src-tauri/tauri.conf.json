{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stepwell Scraper",
  "version": "1.1.1",
  "identifier": "com.detau.map-scraper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build && cd src-tauri/zalo-sidecar && npm install && node build.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stepwell Scraper",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "zalo-sidecar/bundle.cjs": "zalo-sidecar/bundle.cjs",
      "zalo-sidecar/package.json": "zalo-sidecar/package.json"
    },
    "externalBin": [
      "binaries/node"
    ]
  }
}
